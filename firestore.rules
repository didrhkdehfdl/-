rules_version = '2';

// 경기지사 업무프로그램 Firestore 보안 규칙
//
// 기존 규칙에서 바뀐 점은 한 가지 — 관리자 판정에 isAdmin을 더했다.
//  1) 코드에 고정된 관리자 이메일(index.html의 ADMIN_EMAILS와 같은 목록)
//  2) users/{uid} 문서의 isAdmin == true  ← 승인관리 화면에서 지정한 관리자
// 이 규칙을 올리기 전에는 1번만 인정해서, 화면에서 관리자로 지정해도 서버가
// 사용자 목록 읽기를 막아 "목록을 불러오지 못했습니다"가 떴다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 고정 관리자 — index.html의 ADMIN_EMAILS와 같은 값을 유지한다.
    function isFixedAdmin() {
      return request.auth != null
        && request.auth.token.email in ['pract@naver.com', 'chanho@admin.com'];
    }
    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isFixedAdmin()
        || (request.auth != null && myDoc().get('isAdmin', false) == true);
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // 가입 신청은 본인 문서만, 승인·관리자 여부를 스스로 켜지 못하게 막는다.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.approved == false
        && request.resource.data.get('isAdmin', false) == false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /app_data/{key} {
      allow read, write: if request.auth != null
        && (isAdmin() || myDoc().get('approved', false) == true);
    }
  }
}
